    "projectsSection": {
      "type": "enumeration",
      "enum": [
        "commercials",
        "music-videos"
      ]
    },
    "projectsOrder": {
      "type": "integer",
      "min": 0
    },
    "showInArtistPortfolio": {
      "type": "boolean",
      "default": true
    }
  }
