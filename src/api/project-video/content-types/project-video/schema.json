{
  "kind": "collectionType",
  "collectionName": "project_videos",
  "info": {
    "singularName": "project-video",
    "pluralName": "project-videos",
    "displayName": "ProjectVideos",
    "description": ""
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "config": {
    "attributes": {
      "showInProjects": {
        "hidden": true
      }
    }
  },
  "attributes": {
