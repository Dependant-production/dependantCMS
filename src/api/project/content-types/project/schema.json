{
  "kind": "collectionType",
  "collectionName": "projects",
  "info": {
    "singularName": "project",
    "pluralName": "projects",
    "displayName": "projectsPhotos",
    "description": ""
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "config": {
    "attributes": {
      "showInProjects": {
        "hidden": true
      }
    }
  },
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "coverMedia": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "media": {
      "type": "media",
      "multiple": true,
      "required": true,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "projectSlug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "showInProjects": {
      "type": "boolean",
      "default": false
    },
    "projectsSection": {
      "type": "enumeration",
      "enum": [
        "commercials",
        "music-videos"
      ]
    },
    "projectsOrder": {
      "type": "integer",
      "min": 0
    },
    "showInArtistPortfolio": {
      "type": "boolean",
      "default": true
    }
  }
}
