# Copy to .env.preprod in the separate preproduction checkout.
# Generate fresh secrets here; do not copy the production .env.
# This file is read by ecosystem.preprod.config.cjs and Strapi ENV_PATH.

NODE_ENV=production
HOST=127.0.0.1
PORT=1338
PUBLIC_URL=https://cms-preprod.dependant.tv
CORS_ORIGINS=https://cms-preprod.dependant.tv,https://preprod.dependant.tv

# Dedicated PostgreSQL role and database on the existing local PostgreSQL server.
DATABASE_CLIENT=postgres
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=dependant_preprod
DATABASE_USERNAME=dependant_preprod
DATABASE_PASSWORD=
DATABASE_SSL=false
DATABASE_POOL_MIN=0
DATABASE_POOL_MAX=5

# Files remain in this checkout's public/uploads directory, separate from S3.
UPLOAD_PROVIDER=local

# Generate independent random secrets. APP_KEYS is a comma-separated list.
APP_KEYS=
ADMIN_JWT_SECRET=
API_TOKEN_SALT=
TRANSFER_TOKEN_SALT=
JWT_SECRET=

# Existing videos remain readable; uploading and modifying Mux assets is disabled.
MUX_UPLOADS_ENABLED=false
# Required only if uploads are enabled, using a separate Mux environment.
MUX_ACCESS_TOKEN_ID=
MUX_SECRET_KEY=

# Install Node 22 separately; do not replace the production Node binary.
PREPROD_NODE_PATH=/home/ubuntu/.local/opt/dependant-preprod-node22/bin/node
STRAPI_TELEMETRY_DISABLED=true
